CREATE TABLE t4 (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    value INTEGER NOT NULL,
    payload TEXT NOT NULL
);

insert:
INSERT INTO t4(name, value, payload) VALUES (?, ?, ?);

count:
SELECT COUNT(*) FROM t4;

latest:
SELECT * FROM t4 ORDER BY id DESC LIMIT 200;

scan:
SELECT COALESCE(SUM(LENGTH(payload)), 0) FROM t4;
