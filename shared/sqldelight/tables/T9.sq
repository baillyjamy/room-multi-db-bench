CREATE TABLE t9 (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    value INTEGER NOT NULL,
    payload TEXT NOT NULL
);

insert:
INSERT INTO t9(name, value, payload) VALUES (?, ?, ?);

count:
SELECT COUNT(*) FROM t9;

latest:
SELECT * FROM t9 ORDER BY id DESC LIMIT 200;

scan:
SELECT COALESCE(SUM(LENGTH(payload)), 0) FROM t9;
